<%- include('partials/header') %>

<div class="page-head">
  <h1><%= note.title %></h1>
  <a class="btn btn-secondary" href="/">All Notes</a>
</div>

<article class="card">
  <span class="topic-tag"><%= note.topic %></span>
  <p><%= note.body %></p>
  <div class="card-actions">
    <form action="/notes/<%= note.id %>/delete" method="POST">
      <button class="btn btn-danger" type="submit">Delete Note</button>
    </form>
  </div>
</article>

  </main>
</body>
</html>