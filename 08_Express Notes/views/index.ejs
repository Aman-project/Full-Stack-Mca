<%- include('partials/header') %>

<div class="page-head">
  <h1>Notes (<%= notes.length %>)</h1>
  <a class="btn" href="/notes/new">+ New Note</a>
</div>

<% if (notes.length === 0) { %>
  <div class="card">
    <h2>No notes yet</h2>
    <p>Create your first note to test the POST route.</p>
    <a class="btn" href="/notes/new">Create Note</a>
  </div>
<% } else { %>
  <div class="notes-list">
    <% notes.forEach(note => { %>
      <article class="card">
        <span class="topic-tag"><%= note.topic %></span>
        <h2><%= note.title %></h2>
        <p><%= note.body %></p>
        <div class="card-actions">
          <a class="btn btn-secondary" href="/notes/<%= note.id %>">Open</a>
          <form action="/notes/<%= note.id %>/delete" method="POST">
            <button class="btn btn-danger" type="submit">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

  </main>
</body>
</html>