<%- include('partials/header') %>

<div class="page-header">
  <h1>Edit Product</h1>
  <a class="btn btn-secondary" href="/products/<%= product.id %>">Cancel</a>
</div>

<% if (error) { %>
  <div class="error-box"><%= error %></div>
<% } %>

<form class="product-form" action="/products/<%= product.id %>?_method=PUT" method="POST">
  <div class="field">
    <label for="name">Product Name</label>
    <input
      id="name"
      name="name"
      type="text"
      value="<%= product.name %>"
      required
    />
  </div>

  <div class="field">
    <label for="price">Price (₹)</label>
    <input
      id="price"
      name="price"
      type="number"
      step="0.01"
      min="0"
      value="<%= product.price %>"
      required
    />
  </div>

  <div class="field">
    <label for="image">Image URL</label>
    <input
      id="image"
      name="image"
      type="url"
      value="<%= product.image %>"
      required
    />
  </div>

  <div class="field">
    <label for="description">Description</label>
    <textarea
      id="description"
      name="description"
      rows="4"
      required
    ><%= product.description %></textarea>
  </div>

  <div class="actions">
    <button class="btn" type="submit">Update Product</button>
  </div>
</form>

  </main>
</body>
</html>