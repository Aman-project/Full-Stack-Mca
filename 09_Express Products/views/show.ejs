<%- include('partials/header') %>

<div class="page-header">
  <h1><%= product.name %></h1>
  <a class="btn btn-secondary" href="/products">All Products</a>
</div>

<article class="card detail-card">
  <img
    class="detail-image"
    src="<%= product.image %>"
    alt="<%= product.name %>"
    onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22320%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23eeece4%22/><text x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%235c6560%22 font-family=%22sans-serif%22 font-size=%2218%22>Image Unavailable</text></svg>';"
  />
  <div class="card-body">
    <div>
      <div class="price">₹<%= Number(product.price).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <p><%= product.description %></p>
    </div>
    <div class="actions">
      <a class="btn" href="/products/<%= product.id %>/edit">Edit Product</a>
      <form action="/products/<%= product.id %>?_method=DELETE" method="POST">
        <button class="btn btn-danger" type="submit">Delete Product</button>
      </form>
    </div>
  </div>
</article>

  </main>
</body>
</html>